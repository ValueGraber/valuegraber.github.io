rules_version = '2';
// Firestore rules for every app on valuegraber.github.io (Firebase project "valuegrab").
// Paste into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }

    // ValueGrab (index.html): one document per account in each collection.
    // portfolios = stocks + spot gold + gold trading journal + watchlist, business = biz ledger, money = personal money + app settings
    match /portfolios/{uid} { allow read, write: if owner(uid); }
    match /business/{uid}   { allow read, write: if owner(uid); }
    match /money/{uid}      { allow read, write: if owner(uid); }

    // Diet app (/diet): profile at diet/{uid}, days and weeks below it
    match /diet/{uid} {
      allow read, write: if owner(uid);
      match /{sub}/{id} { allow read, write: if owner(uid) && sub in ['days', 'weeks']; }
    }
    // Diet app, older storage path
    match /data/users/{uid}/{id} { allow read, write: if owner(uid); }

    // Durian garden app (/durian): anonymous sign-in, garden id = SHA-256 of name + code.
    // Anyone signed in who knows the id may use the garden; listing all gardens is not allowed.
    match /gardens/{gid} {
      allow get, create, update: if signedIn();
      match /{sub}/{id} {
        allow read, write: if signedIn() && exists(/databases/$(database)/documents/gardens/$(gid))
          && sub in ['trees', 'works', 'flowers', 'sales', 'money', 'stock', 'chems', 'recipes', 'meta', 'photos'];
      }
    }
    // everything else is closed
  }
}
